# Ambiente Python
.venv/
__pycache__/
*.pyc

# Dados brutos: arquivos oficiais grandes e binários (.xlsx não diferencia
# bem em git), re-obteníveis na fonte (SIP/PROCERGS). O 2026 em particular
# é atualizado periodicamente ao longo do ano, o que infla o histórico do
# git a cada nova versão se for versionado.
data/raw/*.xlsx

# Malha geográfica dos municípios do RS: buscada via API do IBGE
# (src/fetch_malha_municipios.py), mesma lógica de outputs/tables/*.csv —
# regenerável, não precisa ficar no histórico do git.
data/raw/*.geojson

# Saídas geradas pelo pipeline (src/load_data.py, src/fetch_populacao.py) —
# regeneráveis a partir de data/raw/, não precisam ser versionadas.
outputs/tables/*.csv
# Exceção: proveniência dos brutos (src/verificar_proveniencia.py) não é
# regenerável a partir de data/raw/ sozinho -- data/raw/*.xlsx é ignorado
# (regra acima), então esse CSV é o único registro no repositório de qual
# versão da SSP/RS foi consumida (hash, data "Atualizado em" declarada,
# metadado OOXML). Pequeno e textual, por isso versionado.
!outputs/tables/proveniencia_dados_brutos.csv
outputs/figures/*
!outputs/figures/.gitkeep

# Tabelas de resultado estatístico das notebooks (analise_exploratoria.ipynb,
# analise_inferencial.ipynb) e dados geoespaciais prontos para o portal
# (src/build_site_data.py) — regeneráveis, mesma lógica de outputs/tables/.
# A cópia publicada fica em docs/assets/data/, essa sim versionada.
outputs/reports/*
!outputs/reports/.gitkeep
outputs/maps/*
!outputs/maps/.gitkeep

# Jupyter
.ipynb_checkpoints/

# Estado local do Claude Code (não é configuração compartilhada do projeto)
.claude/

# SO
.DS_Store

# Material editorial do capítulo (publicacoes/cap_geotecnologias/) — fora do
# escopo do registro de programa de computador junto ao INPE/DIT (src/, docs/).
# PDFs de referências são material de terceiros, não versionado; escopo
# restrito a 01_referencias/ de propósito — não ignora publicacoes/ como um
# todo, nem *.pdf/*.png/*.svg em geral: as figuras finais do capítulo em
# 03_figuras/ SÃO versionadas (produto final, como data/processed/ e docs/).
publicacoes/cap_geotecnologias/01_referencias/*.pdf
!publicacoes/cap_geotecnologias/01_referencias/.gitkeep

# Temporários de compilação LaTeX/Word — restritos a publicacoes/ para não
# capturar arquivos de outras partes do repositório (ex.: log de execução
# do pipeline).
publicacoes/**/*.aux
publicacoes/**/*.log
publicacoes/**/*.out
publicacoes/**/*.bbl
publicacoes/**/*.blg
publicacoes/**/*.toc
publicacoes/**/*.synctex.gz
publicacoes/**/~$*.docx
